# assembly-ui runtime configuration
# ──────────────────────────────────────────────────────────────────────
# This file documents the available runtime variables. Copy it to `.env`
# (git-ignored) to override defaults for local/live runs.
#
# Mode selection
# ──────────────
#   ASSEMBLY_MODE = live   → LIVE: proxy /api to API_TARGET, /nebula to NEBULA_TARGET
#   ASSEMBLY_MODE = mock   → MOCK (default): in-memory seed data in server.js
#
# Port conventions
# ─────────────────
#   MOCK defaults to port 3000 (Google AI Studio convention)
#   LIVE defaults to port 4214 (next free in nexus 4200+ UI range)
#   Both can be overridden with PORT=<n> for ad-hoc runs.
#
# Backend targets (LIVE mode only)
# ────────────────────────────────
#   API_TARGET    → real assembly-srv backend (canonical port 3107)
#   NEBULA_TARGET → real nebula-srv backend  (canonical port 3101)
# ──────────────────────────────────────────────────────────────────────

ASSEMBLY_MODE=

# PORT=4214

# API_TARGET=http://localhost:3107
# NEBULA_TARGET=http://localhost:3101

# DISABLE_HMR=true
