# assembly-ui runtime configuration
# ──────────────────────────────────────────────────────────────────────
# This file documents the available runtime variables. Copy it to `.env`
# (git-ignored) to override defaults for local/live runs.
#
# Ports & targets
# ───────────────
#   PORT          → Vite dev server port (default 4214, nexus 4200+ UI range)
#   API_TARGET    → real assembly-srv backend (canonical port 3107)
#   NEBULA_TARGET → real nebula-srv backend  (canonical port 3101)
#
# Vite dev-server HMR — disabled under systemd (no websocket/react-refresh).
# The file watcher stays live regardless, so source edits invalidate Vite's
# module graph and are picked up on the next request (browser refresh) —
# no service restart needed.
#   DISABLE_HMR=true
# ──────────────────────────────────────────────────────────────────────

# PORT=4214

# API_TARGET=http://localhost:3107
# NEBULA_TARGET=http://localhost:3101

# DISABLE_HMR=true
